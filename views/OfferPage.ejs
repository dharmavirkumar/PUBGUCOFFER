<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>UC Offers | PUBG Mobile UC Sale</title>
  <link rel="stylesheet" href="/OfferPage.css" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <!-- Navbar -->
    <%- include('partial/Navbar')%>
  <!-- Offer Hero -->
  <section class="offer-hero">
    <div class="offer-hero-content">
      <h1>Exclusive PUBG UC Offers</h1>
      <p>Grab the best deals now and get instant UC delivered to your PUBG Mobile account!</p>
    </div>
  </section>

  <!-- Offer Grid -->
  <section class="offer-grid">
    <h2>🔥 Best UC Deals 🔥</h2>
    <div class="offers-container">
      <div class="offer-card">
        <img src="https://i.imgur.com/0Gc7poS.png" alt="60 UC">
        <h3>60 UC</h3>
        <p class="price">₹79 <span class="bonus">No Bonus</span></p>
        <a href="#" class="btn">Buy Now</a>
      </div>

      <div class="offer-card">
        <img src="https://i.imgur.com/nLQvY2y.png" alt="325 UC">
        <h3>325 UC</h3>
        <p class="price">₹399 <span class="bonus">+25 UC Bonus</span></p>
        <a href="#" class="btn">Buy Now</a>
      </div>

      <div class="offer-card">
        <img src="https://i.imgur.com/lzQ8Jey.png" alt="600 UC">
        <h3>600 UC</h3>
        <p class="price">₹699 <span class="bonus">+60 UC Bonus</span></p>
        <a href="#" class="btn">Buy Now</a>
      </div>

      <div class="offer-card">
        <img src="https://i.imgur.com/pYt3LTu.png" alt="1800 UC">
        <h3>1800 UC</h3>
        <p class="price">₹1999 <span class="bonus">+300 UC Bonus</span></p>
        <a href="#" class="btn">Buy Now</a>
      </div>

      <div class="offer-card">
        <img src="https://i.imgur.com/x9z7UjV.png" alt="3850 UC">
        <h3>3850 UC</h3>
        <p class="price">₹3899 <span class="bonus">+850 UC Bonus</span></p>
        <a href="#" class="btn">Buy Now</a>
      </div>

      <div class="offer-card">
        <img src="https://i.imgur.com/cxEZa3C.png" alt="8100 UC">
        <h3>8100 UC</h3>
        <p class="price">₹7499 <span class="bonus">+2000 UC Bonus</span></p>
        <a href="#" class="btn">Buy Now</a>
      </div>
    </div>
  </section>

  <!-- Support Section -->
  <section id="contact" class="contact">
    <h2>Need Help?</h2>
    <p>For payment or delivery assistance, contact us below:</p>
    <form>
      <input type="text" placeholder="Your Name" required />
      <input type="email" placeholder="Your Email" required />
      <textarea placeholder="Your Message" rows="4" required></textarea>
      <button type="submit" class="btn">Send Message</button>
    </form>
  </section>

  <!-- Footer -->
  <footer>
    <p>&copy; 2025 PUBGUCStore | Instant UC Top-up | All Rights Reserved.</p>
  </footer>
</body>
</html>
